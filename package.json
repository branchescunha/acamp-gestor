{
  "name": "acamp-gestor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test src/domain/__tests__/*.test.js src/utils/__tests__/*.test.js src/features/export/__tests__/*.test.js src/features/participants/__tests__/*.test.js src/features/scores/__tests__/*.test.js tests/qa-cleanup/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:all": "npm test && npm run test:integration",
    "qa:inventory": "node scripts/qa-cleanup/cli.js inventory",
    "qa:cleanup:dry-run": "node scripts/qa-cleanup/cli.js dry-run",
    "qa:cleanup": "node scripts/qa-cleanup/cli.js cleanup",
    "preview": "vite preview",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.2.4",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "vite": "^8.0.16"
  }
}
